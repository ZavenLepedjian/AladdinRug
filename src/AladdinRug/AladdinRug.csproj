<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>AladdinRug</AssemblyName>
    <Product>Aladdin Rug</Product>
    <Description>A rug for your Windows desktop: heavy cloth you can lift, fold and roll, with a merchant who tidies up.</Description>
    <Version>1.0.0</Version>
    <RootNamespace>AladdinRug</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFAC010/WFO0003: the high-DPI mode is set in app.manifest (what WPF needs); WinForms is only used for the tray icon and dialogs -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>

</Project>
